{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/sunrider-sales-dashboard.html" },
    { "source": "/dashboard", "destination": "/sunrider-sales-dashboard.html" }
  ],
  "headers": [
    { "source": "/pincodes.json", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" } ] },
    { "source": "/data.json", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ] },
    { "source": "/(.*)", "headers": [ { "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" } ] }
  ]
}
